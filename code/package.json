    "verify": "npm run lint && npm run typecheck && npm run test && npm run build && npm run analyze:budget"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "phaser": "^4.2.1",
    "preact": "^10.29.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^24.13.3",
    "eslint": "^10.8.1",
    "eslint-plugin-preact": "^0.1.0",
    "globals": "^17.3.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  }
}
